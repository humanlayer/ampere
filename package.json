{
	"name": "ampere",
	"private": true,
	"workspaces": [
		"packages/*"
	],
	"type": "module",
	"scripts": {
		"build": "vp run -r build",
		"dev": "vp run -r --parallel dev",
		"test": "vp test",
		"check": "vp check && bun run check:typed",
		"check:typed": "bun tools/typed-lint/cli.ts check --config tools/typed-lint/config.json",
		"check:diff": "bun tools/diff-check/main.ts --config tools/diff-check/config.json",
		"check:automation-inventory": "bun tools/automation-audit.ts",
		"lint": "vp lint",
		"lint:fix": "vp lint --fix",
		"format": "vp fmt --check",
		"format:write": "vp fmt --write",
		"typecheck": "vp run -r typecheck",
		"prepare": "effect-tsgo patch --oxlint"
	},
	"devDependencies": {
		"@effect/language-service": "0.86.2",
		"@effect/tsgo": "0.38.0",
		"@oxlint/plugins": "1.80.0",
		"@types/bun": "catalog:",
		"@types/node": "catalog:",
		"eslint-plugin-better-tailwindcss": "4.7.0",
		"fast-glob": "3.3.3",
		"oxlint": "1.80.0",
		"oxlint-tsgolint": "7.0.2001",
		"tailwindcss": "4.2.2",
		"typescript": "catalog:",
		"typescript-compiler": "npm:typescript@5.9.3",
		"vite-plus": "0.3.0",
		"vitest": "catalog:"
	},
	"overrides": {
		"effect": "4.0.0-rc.110",
		"vite": "npm:@voidzero-dev/vite-plus-core@0.3.0"
	},
	"engines": {
		"node": ">=24"
	},
	"packageManager": "bun@1.3.14",
	"catalog": {
		"effect": "4.0.0-rc.110",
		"@effect/opentelemetry": "4.0.0-rc.110",
		"@effect/platform-browser": "4.0.0-rc.110",
		"@effect/platform-bun": "4.0.0-rc.110",
		"@effect/platform-node": "4.0.0-rc.110",
		"@effect/vitest": "4.0.0-rc.110",
		"vitest": "4.1.11",
		"typescript": "7.0.2",
		"@types/bun": "^1.3.10",
		"@types/node": "^25.3.5",
		"drizzle-orm": "1.0.0-rc.5-169397b",
		"@effect/sql-pg": "4.0.0-rc.110",
		"effect-machine": "0.17.1"
	}
}
