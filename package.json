{
	"name": "ampere",
	"private": true,
	"workspaces": [
		"packages/*"
	],
	"type": "module",
	"scripts": {
		"build": "vp run -r build",
		"dev": "vp run -r --parallel dev",
		"test": "vp test",
		"check": "vp check",
		"lint": "vp lint",
		"lint:fix": "vp lint --fix",
		"machine:devtools": "bun tools/patch-effect-machine-devtools.mjs && effect-machine --root ./packages/replication-setup --include \"src/machine.ts\" --host 127.0.0.1 --port 4173 --open",
		"machine:devtools:build": "bun tools/patch-effect-machine-devtools.mjs && effect-machine build --root ./packages/replication-setup --include \"src/machine.ts\" --out-dir .effect-machine/site",
		"format": "vp fmt --check",
		"format:write": "vp fmt --write",
		"typecheck": "vp run -r typecheck",
		"prepare": "effect-tsgo patch --typescript --oxlint"
	},
	"devDependencies": {
		"@effect/language-service": "0.86.2",
		"@effect/tsgo": "0.38.0",
		"@oxlint/plugins": "1.80.0",
		"@typeonce/effect-machine-devtools": "0.27.1",
		"@typeonce/oxlint-plugin-effect-machine": "0.27.1",
		"@types/bun": "catalog:",
		"@types/node": "catalog:",
		"oxlint": "1.80.0",
		"oxlint-tsgolint": "7.0.2001",
		"typescript": "catalog:",
		"vite-plus": "0.3.0",
		"vitest": "catalog:"
	},
	"overrides": {
		"effect": "4.0.0-rc.112",
		"vite": "npm:@voidzero-dev/vite-plus-core@0.3.0"
	},
	"engines": {
		"node": ">=24"
	},
	"packageManager": "bun@1.3.14",
	"catalog": {
		"effect": "4.0.0-rc.112",
		"@typeonce/effect-machine": "0.27.1",
		"@effect/opentelemetry": "4.0.0-rc.112",
		"@effect/platform-browser": "4.0.0-rc.112",
		"@effect/platform-bun": "4.0.0-rc.112",
		"@effect/platform-node": "4.0.0-rc.112",
		"@effect/vitest": "4.0.0-rc.112",
		"vitest": "4.1.11",
		"typescript": "7.0.2",
		"@types/bun": "^1.3.10",
		"@types/node": "^25.3.5",
		"@types/pg": "8.23.1",
		"drizzle-orm": "1.0.0-rc.5-169397b",
		"pg": "8.23.0"
	}
}
