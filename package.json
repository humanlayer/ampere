{
	"name": "ampere",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"type": "module",
	"scripts": {
		"build": "vp run -r build",
		"dev": "vp run -r --parallel dev",
		"test": "vp test",
		"check": "vp check",
		"lint": "vp lint",
		"lint:fix": "vp lint --fix",
		"format": "vp fmt --check",
		"format:write": "vp fmt --write",
		"typecheck": "vp run -r typecheck",
		"prepare": "effect-tsgo patch --typescript --oxlint"
	},
	"devDependencies": {
		"@effect/language-service": "0.86.2",
		"@effect/tsgo": "0.36.4",
		"@oxlint/plugins": "1.77.0",
		"@types/bun": "catalog:",
		"@types/node": "catalog:",
		"oxlint-tsgolint": "7.0.2001",
		"typescript": "catalog:",
		"vite-plus": "0.2.8",
		"vitest": "catalog:"
	},
	"overrides": {
		"effect": "4.0.0-rc.110",
		"vite": "npm:@voidzero-dev/vite-plus-core@0.2.8"
	},
	"engines": {
		"node": ">=24"
	},
	"packageManager": "bun@1.3.14",
	"catalog": {
		"effect": "4.0.0-rc.110",
		"@effect/opentelemetry": "4.0.0-rc.110",
		"@effect/platform-browser": "4.0.0-rc.110",
		"@effect/platform-bun": "4.0.0-rc.110",
		"@effect/platform-node": "4.0.0-rc.110",
		"@effect/vitest": "4.0.0-rc.110",
		"vitest": "4.1.10",
		"typescript": "7.0.2",
		"@types/bun": "^1.3.10",
		"@types/node": "^25.3.5",
		"drizzle-orm": "1.0.0-rc.5-169397b",
		"@effect/sql-pg": "4.0.0-rc.110",
		"effect-machine": "0.17.1"
	}
}
